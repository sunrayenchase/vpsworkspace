# 1. Ignore absolutely everything by default
*
.*

# 2. Allow your core project configuration files
!docker-compose.yml
!Dockerfile.caddy
!README.md
!.gitignore

# 3. Allow your environment variable template
!.env.example

# 4. Allow your custom scripts folder and everything inside it
!bscript/
!bscript/**

# 5. Allow Caddy structural tracking but ignore dynamic data/configs
!caddy/
!caddy/Caddyfile

# 6. Allow folder structures into index tree
!3x-ui/
!3x-ui/db/
!3x-ui/cert/
!syncthing/
!caddy/config/
!caddy/data/
!.backup/

# 7. Fail2ban Core Configurations Allow-list
!fail2ban/
!fail2ban/jail.d/
!fail2ban/jail.d/jail.local
!fail2ban/filter.d/
!fail2ban/filter.d/sshd.conf

# =======================================================================
# 8. Ignore all production runtime data (BLOCK RULES)
# =======================================================================
3x-ui/db/*
3x-ui/cert/*
syncthing/*
caddy/config/*
caddy/data/*
.backup/*

# =======================================================================
# 9. Explicitly force placeholder exceptions (LAST UNBLOCK RULES WIN)
# =======================================================================
!3x-ui/db/.gitkeep
!3x-ui/cert/.gitkeep
!syncthing/.gitkeep
!caddy/config/.gitkeep
!caddy/data/.gitkeep
!/.backup/.gitkeep
