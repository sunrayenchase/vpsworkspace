# --- Host System Configurations ---
USER_ID=1000
TZ=Europe/Moscow

# --- Network Topology Configurations ---
SUBNET4=172.20.0.0/16
SUBNET6=fd00:172:20::/64
XUI4=172.20.0.3x

# --- Domain & Provider Access Tokens ---
DUCKDNSDOMAIN=sub.duckdns.org
DUCKDNSTOKEN=your_duckdns_api_token_here

# --- Subdomain Routing Subkeys ---
XUI_WEB=vpn
SYNC_WEB=sync

# --- Internal Networking Ports ---
XUI_PANEL_PORT=2053
XUI_REVERSE_PROXY_PORT=1234
XUI_INBOUND_PORT=10443
SYNC_PANEL_PORT=8384

# --- Hidden Application Routing Paths ---
SYNC_SECRET_PATH=st-bk-9x27

# --- Automated System Backup Rules ---
BACKUP_FOLDER_NAME=.backup
EXCLUDES_FOLDERS="bscript node_modules venv cache tmp logs"
COPIES_TO_KEEP=7
CRON_SCHEDULE="0 2 15 * *"